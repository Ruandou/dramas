.DS_Store
*.swp
*~

# 视频文件（体积大，不推送）
*.mp4
**/*.mp4
# ffmpeg 预告片输出与临时分段（体积大，本地生成即可）
video/output/
video/**/tmp_segments/
# 即梦 API 本地下载的成片（MCP volc_download_video）
video/generated/
# 短剧视频素材
darams/*/video/
darams/*/generated/
darams/*/output/
# 段落 dry-run 请求体（含 base64 参考图，可脚本再生）
darams/*/configs/seedance_requests/
# 含 task_id 的本地配置勿提交
video/automation/ep01_task_ids.json

# Cursor MCP 本地密钥勿提交
.cursor/mcp.json

# Node
mcps/**/node_modules/

# Python
__pycache__/
*.py[cod]

# 构建产物（build_site.py 生成，可随时重建）
site/
*$py.class

# Site build output
site/
**/assets/generated/**/_subs/
corpus_external/
