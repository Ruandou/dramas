{
  "mcpServers": {
    "volc-jimeng": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/mcps/volc-jimeng/index.mjs"],
      "env": {
        "VOLC_ACCESS_KEY": "你的火山引擎AK",
        "VOLC_SECRET_KEY": "你的火山引擎SK",
        "ARK_API_KEY": "方舟控制台APIKey（可选）",
        "DRAMA_PROJECT_ROOT": "REPLACE_WITH_ABSOLUTE_PATH/dramas/天工开物"
      }
    },
    "kling": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/mcps/kling/index.mjs"],
      "env": {
        "KLING_AK": "你的可灵API Key",
        "KLING_SK": "你的可灵Secret Key",
        "DRAMA_PROJECT_ROOT": "REPLACE_WITH_ABSOLUTE_PATH/dramas/天工开物"
      }
    },
    "volc-ark": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/mcps/volc-ark/index.mjs"],
      "env": {
        "ARK_API_KEY": "方舟控制台 API Key（Seedream + Seedance）",
        "DRAMA_PROJECT_ROOT": "REPLACE_WITH_ABSOLUTE_PATH/dramas/天工开物"
      }
    },
    "gpt-image": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/mcps/gpt-image/index.mjs"],
      "env": {
        "GPT_IMAGE_API_KEY": "你的 GetGoAPI Key（兼容回退 OPENAI_API_KEY）",
        "GPT_IMAGE_BASE_URL": "https://cn.getgoapi.com",
        "GPT_IMAGE_MODEL": "openai/gpt-image-2",
        "DRAMA_PROJECT_ROOT": "REPLACE_WITH_ABSOLUTE_PATH/dramas/天工开物"
      }
    }
  }
}
