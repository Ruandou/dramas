{
  "mcpServers": {
    "volc-jimeng": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/mcps/volc-jimeng/index.mjs"],
      "env": {
        "VOLC_ACCESS_KEY": "你的火山引擎AK",
        "VOLC_SECRET_KEY": "你的火山引擎SK",
        "ARK_API_KEY": "方舟控制台APIKey（可选）"
      }
    },
    "kling": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/mcps/kling/index.mjs"],
      "env": {
        "KLING_AK": "你的可灵API Key",
        "KLING_SK": "你的可灵Secret Key"
      }
    },
    "volc-ark": {
      "command": "node",
      "args": ["REPLACE_WITH_ABSOLUTE_PATH/mcps/volc-ark/index.mjs"],
      "env": {
        "ARK_API_KEY": "方舟控制台 API Key（Seedream + Seedance）"
      }
    }
  }
}
