{
  "name": "kling_download_image",
  "description": "下载可灵AI生成的图片到本地，并归档任务。",
  "arguments": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "图片URL（从query_image_task返回的image_urls数组中获取）"
      },
      "output_path": {
        "type": "string",
        "description": "输出文件路径"
      },
      "task_id": {
        "type": "string",
        "description": "任务ID（用于归档，可选）"
      }
    },
    "required": ["url", "output_path"]
  }
}